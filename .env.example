# ============================================================
# Environment Configuration — AI Customer Feedback Analyzer
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Required ---

# Your Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Optional (defaults shown) ---

# Groq model to use for analysis
# Recommended free options: llama-3.1-8b-instant | llama-3.3-70b-versatile
MODEL_NAME=llama-3.1-8b-instant

# Path to the SQLite database file (created automatically)
DB_PATH=output/feedback.db

# Directory where output CSV/JSON files are written
OUTPUT_DIR=output

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=30

# Maximum retry attempts for transient LLM errors
LLM_MAX_RETRIES=3
